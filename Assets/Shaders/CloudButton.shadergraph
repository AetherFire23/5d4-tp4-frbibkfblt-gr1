        }
    },
    "m_Slots": [
        {
            "m_Id": "cc9efb9485294780a59f5d72c16b5eb9"
        },
        {
            "m_Id": "ba3ad04e85a14a50ab8da0456f788843"
        },
        {
            "m_Id": "f559e06282b64dc2a21b23ef9f720977"
        },
        {
            "m_Id": "6530c1a4229641c19c2602a5fa59ce48"
        },
        {
            "m_Id": "9540879395384ab28f933718ab1ca147"
        },
        {
            "m_Id": "259a01beef124343b5dc3c8bc406dc1e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CloudShape",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float A = abs(ddy(UV.y)) / max(abs(ddx(UV.x)), 0.000001);\nfloat2 p = (UV - 0.5) * float2(A, 1.0);\nfloat margin = BumpSize * 1.15 + 0.04;\nfloat b = max(0.5 - margin, 0.05);\nfloat a = max(A * 0.5 - margin, b);\nint n = (int)clamp(ceil(6.2832 * a / (BumpSize * 0.4)), 6.0, 300.0);\nfloat da = 6.2832 / n;\nfloat d = 1000.0;\n[loop]\nfor (int i = 0; i < 300; i++)\n{\n    if (i >= n) break;\n    float h1 = frac(sin(i * 12.9898 + Seed * 78.233) * 43758.5453);\n    float h2 = frac(sin(i * 39.3468 + Seed * 11.135) * 24634.6345);\n    float t = (i + (h1 - 0.5) * 0.4) * da;\n    float2 c = float2(cos(t) * a, sin(t) * b);\n    float r = BumpSize * lerp(0.7, 1.0, h2) * lerp(0.8, 1.15, sin(t) * 0.5 + 0.5);\n    d = min(d, length(p - c) - r);\n}\nDistRing = d;\nDistCore = (length(p / float2(a, b)) - 1.0) * b;\nAspect = A;"
}

