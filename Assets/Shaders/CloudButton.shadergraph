{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "dcb1ff9328d14742944f5cd4145c003c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CloudShape (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1051.199951171875,
            "y": 598.4000854492188,
